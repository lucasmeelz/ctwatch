# Optional API keys. None of them are required to run a basic scan.
# Copy this file to .env and fill in the values you actually have.

# SSLMate Cert Spotter — free tier allows a limited number of queries per hour.
# https://sslmate.com/certspotter/
CERTSPOTTER_API_KEY=

# urlscan.io — used to render suspicious pages through a third party,
# so that the analyst's own address is never exposed to the target.
# https://urlscan.io/user/apikey/
URLSCAN_API_KEY=
